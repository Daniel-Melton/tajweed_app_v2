datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // هيرجع يشتغل كلاسيكي ومستقر 100%
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  STUDENT
}

model User {
  id             String   @id @default(uuid()) // استخدام UUID لـ PostgreSQL
  name           String
  email          String?  @unique
  phoneNumber    String?  @unique 
  password       String   
  role           UserRole @default(STUDENT)
  

  totalStars     Int      @default(0)
  masteredSkills String[] @default([]) 

  testResults    TestResult[] 
  certificates   Certificate[]
  createdSkills  Skill[]      
  progress       UserProgress[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Skill {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  concept     String   @db.Text
  videoUrl    String?  // رابط الفيديو
  quizId      String?  // ربط بالاختبار
  createdAt   DateTime @default(now())
  questions   Question[]
  quranExamples QuranExample[]
  order       Int      @default(0)
  userProgress UserProgress[]
  // العلاقات
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdById String
}

model QuranExample {
  id          String   @id @default(cuid())
  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  surahName   String   // اسم السورة (مثال: "سورة البقرة") — للعرض بس
  surahNumber Int      @default(0) // رقم السورة في المصحف (1-114) — ده اللي بيستخدم فعليًا لجلب الصوت
  ayahNumber  Int      // رقم الآية داخل السورة
  verseText   String   @db.Text // نص الآية كاملاً

  // المقاطع/الكلمات المطلوب تلوينها داخل verseText (مطابقة نصية حرفية).
  // مثال: ["مَنْ يَقُولُ"] هيلوّن الكلمتين دول لو ظهروا بالظبط بنفس التشكيل جوه verseText.
  highlights  String[] @default([])

  // مسار الملف الصوتي المحلي بعد التحميل والدمج في المشروع (public/audio/...).
  // لو null بيتم تشغيل الصوت مباشرة من الـ API الخارجي كـ fallback.
  audioHusaryPath   String?
  audioMinshawiPath String?

  order       Int      @default(0)

  @@index([skillId])
}

model Question {
  id            String   @id @default(uuid())
  skillId       String   
  skill         Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  text          String
  questionText  String   
  options       String[] 
  correctAnswer String   
  points        Int      @default(1) 
}

model TestResult {
  id             String   @id @default(uuid())
  userId         String   
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  skillSlug      String   
  skillTitle     String   
  score          Int      
  totalQuestions Int  
  isPassed       Boolean  
  wrongAnswers   Json?  

  createdAt      DateTime @default(now()) 
}

model Certificate {
  id              String   @id @default(uuid())
  userId          String   
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  certificateName String   
  serialNumber    String   @unique 
  designerName    String   @default("Ahmad Ismael") 
  
  issuedAt        DateTime @default(now()) 
}

model UserProgress {
  id          String   @id @default(cuid())
  userId      String
  skillId     String
  isCompleted Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  skill       Skill    @relation(fields: [skillId], references: [id])

  @@unique([userId, skillId]) // عشان نضمن إن مفيش تكرار لنفس الدرس لنفس الطالبة
}